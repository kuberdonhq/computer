#!/usr/bin/env bash
#
# computer: one command to set up a Kuberdon MacBook.
#
#   ./computer            set up this Mac, or bring it up to date (safe to run again)
#   ./computer doctor     say what is missing or out of date, change nothing
#   ./computer --dry-run  print what it would do, change nothing
#
# Inspired by thoughtbot/laptop. Every step checks first and only acts when
# something is missing, so a second run changes nothing.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DRY_RUN=0
COMMAND="setup"
WALLPAPER_URL="https://kuberdon.eu/press/wallpapers/kuberdon-mark-night-macbook.png"
OP_AGENT_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
OP_SSH_SIGN="/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

for arg in "$@"; do
  case "$arg" in
    doctor) COMMAND="doctor" ;;
    --dry-run) DRY_RUN=1 ;;
    -h | --help) sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown option: $arg" >&2; exit 2 ;;
  esac
done

bold() { printf '\n\033[1m%s\033[0m\n' "$*"; }
say() { printf '  %s\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
# Each to-do prints where it happens and is listed again, numbered, at the end.
TODO_LIST=()
todo() { printf '  \033[33m•\033[0m %s\n' "$*"; TODO_LIST+=("$*"); }

# Runs a command, or only prints it with --dry-run.
run() {
  if [ "$DRY_RUN" = 1 ]; then
    printf '  would run: %s\n' "$*"
  else
    "$@"
  fi
}

have() { command -v "$1" >/dev/null 2>&1; }

# Sets a global git option only when it differs, so a second run is quiet.
git_set() {
  [ "$(git config --global "$1" || true)" = "$2" ] || run git config --global "$1" "$2"
}

brew_shellenv() {
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
}

# ----------------------------------------------------------------------------
# Steps

check_mac() {
  bold "This Mac"
  if [ "$(uname -s)" != "Darwin" ]; then
    echo "computer sets up a Mac. This is $(uname -s)." >&2
    exit 1
  fi
  ok "macOS $(sw_vers -productVersion) on $(uname -m)"
}

command_line_tools() {
  bold "Command line tools"
  if xcode-select -p >/dev/null 2>&1; then
    ok "installed"
  else
    say "Installing Apple's command line tools. Follow the window that opens, then run computer again."
    run xcode-select --install
    exit 0
  fi
}

homebrew() {
  bold "Homebrew"
  brew_shellenv
  if have brew; then
    ok "installed"
  else
    run /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    brew_shellenv
  fi
  # Homebrew on the PATH in new terminals.
  # shellcheck disable=SC2016 # written to the file as is, expanded by the shell later
  local line='eval "$(/opt/homebrew/bin/brew shellenv)"'
  if [ -x /opt/homebrew/bin/brew ] && ! grep -qsF "$line" "$HOME/.zprofile"; then
    if [ "$DRY_RUN" = 1 ]; then
      say "would add Homebrew to ~/.zprofile"
    else
      printf '\n%s\n' "$line" >>"$HOME/.zprofile"
    fi
  fi
}

apps_and_tools() {
  bold "Apps and tools (Brewfile)"
  if [ "$DRY_RUN" = 1 ]; then
    if have brew && brew bundle check --file="$HERE/Brewfile" >/dev/null 2>&1; then
      ok "everything in the Brewfile is installed"
    else
      say "would run: brew bundle --file=$HERE/Brewfile"
    fi
    return
  fi
  brew update --quiet
  # Homebrew only loads formulae from taps you trust. Trust just Maestro, not its whole tap.
  if brew help trust >/dev/null 2>&1; then
    brew tap mobile-dev-inc/tap >/dev/null
    brew trust --formula mobile-dev-inc/tap/maestro >/dev/null
  fi
  if brew bundle --file="$HERE/Brewfile"; then
    ok "everything in the Brewfile is installed"
  else
    todo "some apps did not install. If macOS asked for permission (Privacy & Security, App Management), allow it for your terminal and run ./computer again"
  fi
}

node() {
  bold "Node"
  if ! have mise; then
    todo "mise is not installed yet"
    return
  fi
  if mise ls --global node 2>/dev/null | grep -q .; then
    ok "Node $(mise exec -- node --version 2>/dev/null || echo '(installed)') through mise"
  else
    run mise use --global node@lts
  fi
  # shellcheck disable=SC2016 # written to the file as is, expanded by the shell later
  local line='eval "$(mise activate zsh)"'
  if ! grep -qsF "$line" "$HOME/.zshrc"; then
    if [ "$DRY_RUN" = 1 ]; then
      say "would add mise to ~/.zshrc"
    else
      printf '\n%s\n' "$line" >>"$HOME/.zshrc"
    fi
  fi
}

# Oh My Zsh on zsh, the default shell. Cloned from its own repo (no install script), and its
# lines go at the top of ~/.zshrc so everything already in there keeps working.
oh_my_zsh() {
  bold "Shell"
  if [ -d "$HOME/.oh-my-zsh" ]; then
    ok "Oh My Zsh is installed (it updates itself)"
  elif [ "$DRY_RUN" = 1 ]; then
    say "would install Oh My Zsh"
  elif git clone --quiet --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.oh-my-zsh"; then
    ok "installed Oh My Zsh"
  else
    todo "Oh My Zsh did not install. Check your internet, then run ./computer again."
    return
  fi
  if ! grep -qs 'oh-my-zsh.sh' "$HOME/.zshrc"; then
    if [ "$DRY_RUN" = 1 ]; then
      say "would load Oh My Zsh in ~/.zshrc"
    else
      local tmp
      tmp="$(mktemp)"
      # shellcheck disable=SC2016 # written to the file as is, expanded by the shell later
      printf '%s\n' 'export ZSH="$HOME/.oh-my-zsh"' 'ZSH_THEME="robbyrussell"' 'plugins=(git)' 'source "$ZSH/oh-my-zsh.sh"' '' >"$tmp"
      cat "$HOME/.zshrc" >>"$tmp" 2>/dev/null || true
      cat "$tmp" >"$HOME/.zshrc"
      rm -f "$tmp"
      ok "your .zshrc loads Oh My Zsh (open a new terminal window to see it)"
    fi
  fi
  local current
  current="$(dscl . -read "$HOME" UserShell 2>/dev/null | awk '{print $2}')"
  if [ "$current" = "/bin/zsh" ]; then
    ok "zsh is your default shell"
  elif [ "$DRY_RUN" = 1 ] || [ ! -t 0 ]; then
    todo "Make zsh your default shell: chsh -s /bin/zsh"
  else
    say "Making zsh your default shell. macOS asks for your Mac password."
    chsh -s /bin/zsh || todo "Make zsh your default shell: chsh -s /bin/zsh"
  fi
}

# The agent is on when its socket answers. ssh-add -l exits 0 (keys) or 1 (no keys) when it
# can reach the agent, and 2 when it cannot.
op_agent_on() {
  [ -S "$OP_AGENT_SOCK" ] || return 1
  local code=0
  SSH_AUTH_SOCK="$OP_AGENT_SOCK" ssh-add -l >/dev/null 2>&1 || code=$?
  [ "$code" -ne 2 ]
}

# ssh-add -L prints "The agent has no identities." on stdout when it has no keys, so keep
# only lines that really are public keys.
agent_key() { SSH_AUTH_SOCK="$OP_AGENT_SOCK" ssh-add -L 2>/dev/null | grep -E '^(ssh-|ecdsa-|sk-)' | head -1 || true; }
valid_key() { printf '%s' "$1" | grep -qE '^(ssh-(rsa|dss|ed25519)|ecdsa-sha2-|sk-)'; }

# No SSH key in 1Password yet: make one there with the 1Password CLI. The private half never
# leaves 1Password. Fails quietly (and the caller adds a to-do) when the CLI is not allowed in.
op_create_ssh_key() {
  if [ "$DRY_RUN" = 1 ]; then say "would create an SSH key in 1Password"; return 1; fi
  have op && [ -t 0 ] || return 1
  say "1Password has no SSH key yet, so computer makes one there. Allow it if 1Password asks."
  op item create --category "SSH Key" --ssh-generate-key Ed25519 \
    --title "SSH key ($(scutil --get ComputerName 2>/dev/null || hostname))" >/dev/null 2>&1 || return 1
  ok "created an SSH key in 1Password"
  sleep 2 # the agent picks up the new key
}

one_password() {
  bold "1Password"
  # SSH keys and commit signing come from 1Password: no private key on disk.
  if ! op_agent_on; then
    if pgrep -xq 1Password; then
      todo "In 1Password, turn on Settings > Developer > Use the SSH agent. If it is on already: quit 1Password (menu bar icon > Quit), open it again, and allow your terminal if macOS asks to access 1Password's data."
    else
      todo "Open 1Password and sign in. It must be running for its SSH agent; turn on Settings > Developer > Use the SSH agent if you have not yet."
    fi
    return
  fi
  ok "the SSH agent is on"
  mkdir -p "$HOME/.ssh"
  if ! grep -qs "2BUA8C4S2C.com.1password" "$HOME/.ssh/config"; then
    if [ "$DRY_RUN" = 1 ]; then
      say "would point ~/.ssh/config at the 1Password agent"
    else
      printf '\nHost *\n  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"\n' >>"$HOME/.ssh/config"
      ok "your SSH config uses the 1Password agent"
    fi
  fi
}

git_config() {
  bold "Git"
  local name email key
  name="$(git config --global user.name || true)"
  email="$(git config --global user.email || true)"
  if [ -z "$name" ] || [ -z "$email" ]; then
    if [ "$DRY_RUN" = 1 ] || [ ! -t 0 ]; then
      todo "Set your name and email: git config --global user.name 'Your Name'; git config --global user.email you@example.com"
    else
      [ -n "$name" ] || read -r -p "  Your full name: " name
      [ -n "$email" ] || read -r -p "  Your work email: " email
      git config --global user.name "$name"
      git config --global user.email "$email"
    fi
  fi
  [ -n "$name" ] && ok "commits as $name <$email>"
  git_set init.defaultBranch main
  git_set pull.rebase true
  git_set push.autoSetupRemote true

  key="$(git config --global user.signingkey || true)"
  if [ "$(git config --global commit.gpgsign || true)" = "true" ] && ! valid_key "$key"; then
    # An older computer could save a non-key as the signing key, which breaks every commit.
    run git config --global --unset commit.gpgsign
    run git config --global --unset user.signingkey
  fi
  if [ "$(git config --global commit.gpgsign || true)" = "true" ]; then
    ok "commits are signed"
  elif op_agent_on && [ -x "$OP_SSH_SIGN" ]; then
    key="$(agent_key)"
    if [ -z "$key" ] && op_create_ssh_key; then key="$(agent_key)"; fi
    if [ -z "$key" ]; then
      todo "Make an SSH key in 1Password: New Item > SSH Key > Add Private Key > Generate a New Key (Ed25519), Save. Then run ./computer again."
    else
      run git config --global gpg.format ssh
      run git config --global gpg.ssh.program "$OP_SSH_SIGN"
      run git config --global user.signingkey "$key"
      run git config --global commit.gpgsign true
      ok "commits are signed with your 1Password SSH key"
    fi
  else
    say "Commit signing turns on once the 1Password SSH agent is on (see the list at the end)."
  fi
}

github() {
  bold "GitHub"
  if ! have gh; then
    todo "gh is not installed yet"
  elif gh auth status >/dev/null 2>&1; then
    ok "signed in to GitHub"
  elif [ "$DRY_RUN" = 1 ] || [ ! -t 0 ]; then
    todo "Sign in to GitHub: gh auth login"
  else
    gh auth login --git-protocol ssh --web
  fi
  github_signing_key
  run mkdir -p "$HOME/Developer"
}

# GitHub shows a commit as Verified only when it knows the signing key, so add it there once.
github_signing_key() {
  local key body list tmp
  key="$(git config --global user.signingkey || true)"
  valid_key "$key" && have gh && gh auth status >/dev/null 2>&1 || return 0
  body="$(printf '%s' "$key" | awk '{print $1" "$2}')"
  # Reading signing keys needs a scope gh does not ask for by default; no list means no scope yet.
  list="$(gh api user/ssh_signing_keys --jq '.[].key' 2>/dev/null || true)"
  if [ -n "$list" ] && printf '%s\n' "$list" | grep -qF "$body"; then
    ok "GitHub knows your signing key (commits show as Verified)"
    return
  fi
  if [ "$DRY_RUN" = 1 ] || [ ! -t 0 ]; then
    todo "Your signing key is not on GitHub yet. Run ./computer in a terminal (not a dry run) and it adds it for you."
    return
  fi
  say "GitHub needs one more permission to add your signing key. A browser window opens."
  if ! gh auth refresh -h github.com -s admin:ssh_signing_key; then
    todo "GitHub did not get the permission to add your signing key. Run this, approve it in the browser, then run ./computer again: gh auth refresh -h github.com -s admin:ssh_signing_key"
    return
  fi
  list="$(gh api user/ssh_signing_keys --jq '.[].key' 2>/dev/null || true)"
  if printf '%s\n' "$list" | grep -qF "$body"; then
    ok "GitHub knows your signing key (commits show as Verified)"
    return
  fi
  tmp="$(mktemp)"
  printf '%s\n' "$body" >"$tmp"
  if gh ssh-key add "$tmp" --type signing --title "1Password signing key ($(scutil --get ComputerName 2>/dev/null || hostname))"; then
    ok "added your signing key to GitHub (commits show as Verified)"
  else
    todo "GitHub refused your signing key. Add it by hand: open github.com/settings/ssh/new, pick Key type: Signing Key, and paste this line: $body"
  fi
  rm -f "$tmp"
}

macos_defaults() {
  bold "macOS settings"
  if [ "$DRY_RUN" = 1 ]; then
    say "would apply macos/defaults.sh"
  else
    # shellcheck source=macos/defaults.sh
    . "$HERE/macos/defaults.sh"
    ok "applied (see macos/defaults.sh)"
  fi
}

kuberdon_look() {
  bold "The Kuberdon look"
  local dir="$HOME/Pictures/Kuberdon"
  local wallpaper="$dir/wallpaper.png"
  if [ "$DRY_RUN" = 1 ]; then
    say "would download the wallpaper to ~/Pictures/Kuberdon"
    return
  fi
  mkdir -p "$dir"
  [ -s "$wallpaper" ] || curl -fsSL "$WALLPAPER_URL" -o "$wallpaper"
  if [ -f "$dir/.wallpaper-set" ]; then
    ok "wallpaper set"
  elif osascript -e "tell application \"System Events\" to tell every desktop to set picture to POSIX file \"$wallpaper\"" >/dev/null 2>&1; then
    touch "$dir/.wallpaper-set"
    ok "wallpaper set"
  else
    todo "Set the wallpaper by hand: right-click $wallpaper in Finder, Set Desktop Picture."
  fi
}

local_layer() {
  # Anything only your company or you need, kept out of this public repo.
  # thoughtbot/laptop's convention: ~/.computer.local runs last, if it exists.
  if [ -f "$HOME/.computer.local" ]; then
    bold "Your local layer (~/.computer.local)"
    if [ "$DRY_RUN" = 1 ]; then
      say "would run ~/.computer.local"
    else
      # shellcheck disable=SC1091
      . "$HOME/.computer.local"
    fi
  fi
}

sign_ins() {
  bold "Sign in"
  say "computer never touches a password. Sign in to each app yourself:"
  say "1Password first, then GitHub, Claude, Notion, Linear and Superhuman."
  if [ "$DRY_RUN" = 0 ] && [ -t 0 ]; then
    # Open each app for its sign-in once, on the first run; a rerun leaves your apps alone.
    local opened="$HOME/.config/computer/opened"
    mkdir -p "$opened"
    for app in 1Password Claude Notion Linear Superhuman; do
      if [ -d "/Applications/$app.app" ] && [ ! -e "$opened/$app" ]; then
        open -g -a "$app" || true
        touch "$opened/$app"
      fi
    done
  fi
}

# ----------------------------------------------------------------------------
# doctor: read only

doctor() {
  brew_shellenv
  bold "Apps and tools"
  if ! have brew; then
    todo "Homebrew is missing: run ./computer"
  else
    local missing
    # brew bundle check exits non-zero when something is missing; read its output anyway.
    missing="$(brew bundle check --file="$HERE/Brewfile" --verbose 2>&1 || true)"
    missing="$(printf '%s\n' "$missing" | grep -E '^→' || true)"
    if [ -z "$missing" ]; then ok "everything in the Brewfile is installed"; else
      while IFS= read -r line; do todo "${line#→ }"; done <<<"$missing"
    fi
    local outdated
    outdated="$(brew outdated --quiet 2>/dev/null | wc -l | tr -d ' ')"
    if [ "$outdated" = 0 ]; then ok "nothing outdated"; else todo "$outdated outdated: brew upgrade"; fi
  fi

  bold "1Password and Git"
  if op_agent_on; then ok "1Password SSH agent is on"; else todo "1Password SSH agent is off"; fi
  if [ "$(git config --global commit.gpgsign || true)" = "true" ] && valid_key "$(git config --global user.signingkey || true)"; then ok "commits are signed"; else todo "commits are not signed: run ./computer"; fi
  if [ -d "$HOME/.oh-my-zsh" ]; then ok "Oh My Zsh"; else todo "Oh My Zsh is missing: run ./computer"; fi
  if [ -n "$(git config --global user.email || true)" ]; then ok "git knows who you are"; else todo "git has no user.email"; fi

  bold "Accounts"
  if have gh && gh auth status >/dev/null 2>&1; then ok "GitHub"; else todo "GitHub: gh auth login"; fi
  if have claude; then ok "Claude Code $(claude --version 2>/dev/null | head -1)"; else todo "Claude Code is missing"; fi
  if have mise && mise exec -- node --version >/dev/null 2>&1; then ok "Node $(mise exec -- node --version)"; else todo "Node is missing: run ./computer"; fi
}

# ----------------------------------------------------------------------------

if [ "$COMMAND" = "doctor" ]; then
  doctor
else
  [ "$DRY_RUN" = 1 ] && echo "Dry run: nothing changes."
  check_mac
  command_line_tools
  homebrew
  apps_and_tools
  node
  oh_my_zsh
  one_password
  git_config
  github
  macos_defaults
  kuberdon_look
  local_layer
  sign_ins
fi

if [ "${#TODO_LIST[@]}" = 0 ]; then
  bold "All set. Welcome to Kuberdon :-)"
else
  if [ "${#TODO_LIST[@]}" = 1 ]; then bold "1 thing left for you:"; else bold "${#TODO_LIST[@]} things left for you:"; fi
  n=0
  for item in "${TODO_LIST[@]}"; do
    n=$((n + 1))
    printf '  %s. %s\n' "$n" "$item"
  done
  echo
  say "Then run ./computer again. It only does what is still missing."
fi
